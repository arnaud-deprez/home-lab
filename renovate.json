{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommits", "helpers:pinGitHubActionDigests", "schedule:weekly"],
  "timezone": "Europe/Brussels",
  "flux": {
    "managerFilePatterns": ["/^(apps|infrastructure)/.+\\.ya?ml$/"]
  },
  "kubernetes": {
    "managerFilePatterns": ["/^(apps|infrastructure)/.+\\.ya?ml$/"]
  },
  "ignorePaths": ["clusters/*/flux-system/**"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Talos version per cluster (controlplane/worker.yaml are git-ignored, so track the version here)",
      "managerFilePatterns": ["/^talos/[^/]+/talos-version\\.env$/"],
      "matchStrings": ["# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\nTALOS_VERSION=(?<currentValue>\\S+)"]
    },
    {
      "customType": "regex",
      "description": "Immich image tag (chart pins an older appVersion; we override it)",
      "managerFilePatterns": ["/^apps/base/immich/helmrelease\\.yaml$/"],
      "matchStrings": ["# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n\\s+tag: (?<currentValue>\\S+)"]
    }
  ],
  "packageRules": [
    {
      "matchManagers": ["flux", "kubernetes"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "minor and patch updates"
    },
    {
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Talos is upgraded by hand (talosctl upgrade): the PR is a reminder, one per cluster, never automerged",
      "matchPackageNames": ["siderolabs/talos"],
      "groupName": null,
      "separateMinorPatch": true,
      "automerge": false,
      "dependencyDashboardApproval": false,
      "addLabels": ["talos-upgrade"]
    },
    {
      "description": "Stateful or migration-heavy: always review by hand, never grouped",
      "matchPackageNames": ["/immich/", "/cloudnative-pg/", "/cnpg/"],
      "groupName": null,
      "automerge": false
    },
    {
      "description": "Backup/helper images: safe to automerge patches once CI is green",
      "matchPackageNames": ["restic/restic", "busybox", "curlimages/curl", "rclone/rclone"],
      "matchUpdateTypes": ["patch"],
      "automerge": true
    }
  ]
}
