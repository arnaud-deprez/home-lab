# Talos version this cluster should run. Renovate opens a PR when a new release appears;
# upgrading the node itself stays manual (talosctl upgrade). Sourced by the docs' `talosctl gen config`.
# renovate: datasource=github-releases depName=siderolabs/talos
TALOS_VERSION=v1.14.7
# Image Factory schematic id (extensions) used for the installer image
SCHEMATIC=376567988ad370138ad8b2698212367b8edcb69b5fd68c80be1f2ec7d603b4ba
